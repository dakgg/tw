// Target relational schema for a future PostgreSQL adapter.
// The current single-process server uses EH_DATA_DIR with one workspace file per user.
generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  displayName  String
  passwordHash String
  passwordSalt String
  demo         Boolean   @default(false)
  createdAt    DateTime  @default(now())
  properties   Property[]
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime

  @@index([userId, expiresAt])
}

model Property {
  userId       String
  user         User                @relation(fields: [userId], references: [id])
  id           String              @id @default(cuid())
  name         String
  address      String              @default("")
  rooms        Room[]
  guests       Guest[]
  reservations Reservation[]
  cleaning     CleaningTask[]
  issues       RoomIssue[]
  messages     Message[]
  claims       Claim[]
  connections  ChannelConnection[]
  activity     Activity[]
}

model Room {
  id           String        @id @default(cuid())
  propertyId   String
  property     Property      @relation(fields: [propertyId], references: [id])
  name         String
  type         String
  capacity     Int
  baseRate     Int
  reservations Reservation[]
  rates        DailyRate[]
  cleaning     CleaningTask[]
  issues       RoomIssue[]

  @@unique([propertyId, name])
}

model Guest {
  id           String        @id @default(cuid())
  propertyId   String
  property     Property      @relation(fields: [propertyId], references: [id])
  name         String
  email        String        @default("")
  note         String        @default("")
  reservations Reservation[]

  @@index([propertyId, email])
}

model Reservation {
  id         String         @id @default(cuid())
  propertyId String
  property   Property       @relation(fields: [propertyId], references: [id])
  roomId     String
  room       Room           @relation(fields: [roomId], references: [id])
  guestId    String
  guest      Guest          @relation(fields: [guestId], references: [id])
  channel    String
  checkIn    DateTime       @db.Date
  checkOut   DateTime       @db.Date
  guests     Int
  total      Int
  commission Int
  settled    Boolean        @default(false)
  status     String         @default("confirmed")
  note       String         @default("")
  createdAt  DateTime       @default(now())
  cleaning   CleaningTask?
  messages   Message[]
  claims     Claim[]

  @@index([propertyId, checkIn, checkOut])
  @@index([roomId, checkIn, checkOut])
}

model DailyRate {
  roomId String
  room   Room     @relation(fields: [roomId], references: [id])
  date   DateTime @db.Date
  price  Int
  closed Boolean  @default(false)

  @@id([roomId, date])
}

model CleaningTask {
  id            String       @id @default(cuid())
  propertyId    String
  property      Property     @relation(fields: [propertyId], references: [id])
  roomId        String
  room          Room         @relation(fields: [roomId], references: [id])
  reservationId String?      @unique
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  date          DateTime     @db.Date
  assignee      String       @default("")
  status        String       @default("todo")
  note          String       @default("")

  @@index([propertyId, date, status])
}

model RoomIssue {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id])
  title       String
  description String   @default("")
  priority    String   @default("normal")
  status      String   @default("todo")
  createdAt   DateTime @default(now())
}

model Message {
  id            String      @id @default(cuid())
  propertyId    String
  property      Property    @relation(fields: [propertyId], references: [id])
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  text          String
  direction     String
  read          Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

model Claim {
  id            String      @id @default(cuid())
  propertyId    String
  property      Property    @relation(fields: [propertyId], references: [id])
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  title         String
  description   String      @default("")
  amount        Int
  status        String      @default("collecting")
  createdAt     DateTime    @default(now())
  evidence      Evidence[]
}

model Evidence {
  id        String   @id @default(cuid())
  claimId   String
  claim     Claim    @relation(fields: [claimId], references: [id])
  name      String
  dataUrl   String   @db.Text
  createdAt DateTime @default(now())
}

model ChannelConnection {
  id         String    @id @default(cuid())
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id])
  channel    String
  externalId String    @default("")
  status     String    @default("not-connected")
  updatedAt  DateTime?

  @@unique([propertyId, channel])
}

model Activity {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  text       String
  createdAt  DateTime @default(now())

  @@index([propertyId, createdAt])
}
