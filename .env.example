# EH: account-based local development. External OTA adapters are not configured.
PORT=4000
API_HOST="127.0.0.1"
WEB_ORIGIN="http://localhost:3000"

# Optional absolute directory. Default: <repository>/.data/project-eh
# Accounts and server sessions: accounts.json
# User-isolated data: workspaces/<user-id>.json
# EH_DATA_DIR="/absolute/path/to/project-eh-data"

# Users create their own ID/password. There is no default or shared admin password.
EH_ALLOW_SIGNUP=true
# Set true behind HTTPS in deployment. false is for local HTTP development only.
EH_COOKIE_SECURE=false

# Optional future PostgreSQL adapter. Current storage is user-isolated JSON files.
DATABASE_URL="postgresql://eh:eh@127.0.0.1:5432/project_eh?schema=public"
